# ── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Stripe API & Webhook Credentials (TEST MODE) ──────────────────────────────
# TEST MODE NOTICE: Replace sk_test_ / pk_test_ / whsec_ with live keys in production.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Stripe Products / Prices (TEST MODE PRICE IDs) ───────────────────────────
# Get these from Stripe Dashboard → Products → Prices
VITE_STRIPE_PRICE_ATHLETE_PRO=price_1Q...   # Athlete Pro $7.99/mo
VITE_STRIPE_PRICE_COACH_BASIC=price_1Q...   # Coach Basic $19.99/mo (up to 5 athletes)
VITE_STRIPE_PRICE_COACH_PLUS=price_1Q...    # Coach Plus $29.99/mo (up to 15 athletes)

# ── OpenAI API Key ────────────────────────────────────────────────────────────
# Stored as Supabase Edge Function secret:
# supabase secrets set OPENAI_API_KEY=sk-proj-...
